# Copy to profiles.yml (git-ignored) or point DBT_PROFILES_DIR at a folder containing it.
db_trade_platform:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      role: "{{ env_var('DBT_SNOWFLAKE_ROLE', 'TRADE_TRANSFORM_ROLE') }}"
      warehouse: "{{ env_var('DBT_SNOWFLAKE_WAREHOUSE', 'TRADE_TRANSFORM_WH') }}"
      database: DB_TRADE_DB
      schema: STANDARD
      authenticator: snowflake_jwt
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      threads: 8
